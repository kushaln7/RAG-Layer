# Environment
APP_ENV=development
DEBUG=True

# Application Settings
APP_TITLE=Data Ingestion Pipeline
STREAMLIT_SERVER_PORT=8501

# Storage Directories
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
VECTOR_STORE_DIR=data/vector_store

# Ingestion Limits
MAX_FILE_SIZE_MB=50

# Default Chunking Settings
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# Embedding Configuration
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
NORMALIZE_EMBEDDINGS=True
FAKE_EMBEDDING_DIM=384

# Vector Store & Access Control
VECTOR_COLLECTION_NAME=canonix_knowledge_base
DEFAULT_ACCESS_LEVEL=internal
DEFAULT_ALLOWED_ROLES=all
RETRIEVAL_TOP_K=4
DEFAULT_MAX_CONTEXT_CHARS=6000

# LLM Configuration (DeepSeek / OpenAI compatible)
LLM_PROVIDER=DeepSeek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/
LLM_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Optional OCR / External Services
TESSERACT_CMD=
